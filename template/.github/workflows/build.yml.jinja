name: Build

on:
  push:
    branches: [main, master]
    tags: ['v*']
  pull_request:
    branches: [main, master]

permissions:
  contents: read

# Main and tags group by run_id: a shared group would cancel their pending runs.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}{% endraw %}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-26.04
    env:
      # Pinned: a new StyLua release can reformat committed Lua with no change in the repo.
      STYLUA_VERSION: 2.6.0

    steps:
      - name: Checkout
        uses: actions/checkout@v6

      # The updater compares a .c4z's version with its release tag, so a tag build
      # stamps the tag's date (make's DRIVER_VERSION), not the runner's UTC date.
      - name: Driver version from tag
        if: github.ref_type == 'tag'
        run: python3 tools/package.py tag-version "$GITHUB_REF_NAME" >> "$GITHUB_ENV"

      - name: Setup Lua
        uses: leafo/gh-actions-lua@v12
        with:
          luaVersion: 'luajit-2.1'

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.x'

      - name: Setup Node
        if: hashFiles('.node-version') != ''
        uses: actions/setup-node@v6
        with:
          node-version-file: .node-version

      - name: Cache stylua
        uses: actions/cache@v6
        with:
          path: {% raw %}${{ runner.temp }}{% endraw %}/stylua
          key: stylua-{% raw %}${{ env.STYLUA_VERSION }}-${{ runner.os }}-${{ runner.arch }}{% endraw %}

      # GitHub's release download can answer 504 for a minute or more. The npm registry has the
      # same binary, published by StyLua's own release workflow.
      - name: Setup stylua
        run: |
          dir="$RUNNER_TEMP/stylua"
          if [ ! -x "$dir/stylua" ]; then
            mkdir -p "$dir"
            arch=$(uname -m)
            fetch="curl -fsSL --retry 6 --retry-all-errors --connect-timeout 15 --max-time 60"
            if $fetch -o "$RUNNER_TEMP/stylua.zip" \
              "https://github.com/JohnnyMorganz/StyLua/releases/download/v$STYLUA_VERSION/stylua-linux-$arch.zip"; then
              unzip -q "$RUNNER_TEMP/stylua.zip" -d "$dir"
            else
              npm=$([ "$arch" = aarch64 ] && echo arm64 || echo x64)
              $fetch "https://registry.npmjs.org/@johnnymorganz/stylua-bin-linux-$npm/-/stylua-bin-linux-$npm-$STYLUA_VERSION.tgz" \
                | tar -xzO package/stylua > "$dir/stylua"
              chmod +x "$dir/stylua"
            fi
          fi
          version=$("$dir/stylua" --version)
          echo "$version"
          [ "$version" = "stylua $STYLUA_VERSION" ]
          echo "$dir" >> "$GITHUB_PATH"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libxml2-dev \
            libxslt-dev \
            libssl-dev \
            swig \
            libpango-1.0-0 \
            libpangocairo-1.0-0 \
            libcairo2 \
            libgdk-pixbuf-2.0-0 \
            fonts-dejavu-core \
            fonts-liberation \
            fonts-noto-core \
            fonts-symbola

      - name: Initialize project
        run: make init

      - name: Check formatting
        run: make check

      - name: Test
        run: make test

      # Each build secret by name, so make build sees no other secret (CONTRIBUTING.md, Build Secrets).
      - name: Build
        run: make build
        env:
          REQUIRE_SECRETS: {% raw %}${{ github.ref_type == 'tag' && '1' || '' }}{% endraw %}
{%- for name in build_secrets.split() %}
          {{ name }}: {% raw %}${{ secrets.{% endraw %}{{ name }}{% raw %} }}{% endraw %}
{%- endfor %}

      - name: Verify the build
        run: make verify
{% for dist in ['drivercentral', 'oss'] %}

      # Tag builds are released and uploaded to Driver Central, so 14 days; main builds are for a quick look, 3; PR builds are for side-loading, 1.
      # A repo with no driver yet builds nothing to upload.
      - name: Upload {{ dist }} artifacts
        if: always() && hashFiles('drivers/*/driver.xml') != ''
        uses: actions/upload-artifact@v7
        with:
          name: {{ dist }}
          path: dist/{{ dist }}/*
          if-no-files-found: error
          retention-days: {% raw %}${{ github.ref_type == 'tag' && 14 || github.event_name == 'pull_request' && 1 || 3 }}{% endraw %}
{% endfor %}
